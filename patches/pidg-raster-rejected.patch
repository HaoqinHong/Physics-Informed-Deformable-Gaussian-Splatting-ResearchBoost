 #include <cooperative_groups.h>
 #include <cooperative_groups/reduce.h>
 namespace cg = cooperative_groups;
+
+// All active pixels at a given inner-loop iteration process the same
+// collected_id[j]. Aggregate their per-Gaussian contributions within each
+// currently active warp group before the original global atomic update.
+// Partition by the actual address as well, so divergent loop progress cannot
+// combine updates for different Gaussians.
+__device__ __forceinline__ void warpAtomicAdd(float* address, float value)
+{
+    auto active = cg::coalesced_threads();
+    auto same_address = cg::labeled_partition(active, address);
+    const float sum = cg::reduce(same_address, value, cg::plus<float>());
+    if (same_address.thread_rank() == 0)
+        atomicAdd(address, sum);
+}
