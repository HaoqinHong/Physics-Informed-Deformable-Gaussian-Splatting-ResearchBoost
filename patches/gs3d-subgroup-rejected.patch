 #include <cooperative_groups.h>
 #include <cooperative_groups/reduce.h>
 namespace cg = cooperative_groups;
+
+// Same-Gaussian active lanes retain every original float contribution while
+// reducing global atomic contention. All local and global accumulation is fp32.
+__device__ __forceinline__ void warpAtomicAdd(
+    const cg::coalesced_group& group, float* address, float value)
+{
+    const float total = cg::reduce(group, value, cg::plus<float>());
+    if (group.thread_rank() == 0)
+        atomicAdd(address, total);
+}
 
