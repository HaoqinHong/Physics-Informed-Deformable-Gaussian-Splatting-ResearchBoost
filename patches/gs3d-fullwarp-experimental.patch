 #include <cooperative_groups.h>
 #include <cooperative_groups/reduce.h>
 namespace cg = cooperative_groups;
+
+// Aggregate only complete same-Gaussian warps. Sparse groups retain the original
+// atomics; every contribution and every accumulation stays float32.
+__device__ __forceinline__ void warpAtomicAdd(
+    unsigned int same_mask, float* address, float value)
+{
+    if (same_mask == 0xffffffffu)
+    {
+        #pragma unroll
+        for (int offset = 16; offset > 0; offset /= 2)
+            value += __shfl_down_sync(0xffffffffu, value, offset);
+        const unsigned int lane = (threadIdx.y * blockDim.x + threadIdx.x) & 31;
+        if (lane == 0)
+            atomicAdd(address, value);
+    }
+    else
+        atomicAdd(address, value);
+}
 
